# Скопируйте в .env и заполните значения. Не добавляйте .env в Git.
APP_ENV=development
DATABASE_PATH=./data/minima-support.sqlite3
SEED_DEMO_DATA=true

# Учётная запись администратора консоли
ADMIN_EMAIL=admin@minima.app
ADMIN_NAME=Алексей Крылов
ADMIN_PASSWORD=

# Сгенерируйте: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

# SMTP для реальной отправки ответов. До заполнения SMTP_HOST/SMTP_FROM отправка отключена.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=12
