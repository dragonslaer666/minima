# Скопируйте в .env и заполните значения. Не добавляйте .env в Git.
APP_ENV=development
DATABASE_PATH=./data/minima-support.sqlite3
SEED_DEMO_DATA=true

# Учётная запись администратора консоли
ADMIN_EMAIL=admin@minima.app
ADMIN_NAME=Алексей Крылов
ADMIN_PASSWORD=

# Сгенерируйте: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

# SMTP для реальной отправки ответов и кодов подтверждения.
# До заполнения SMTP_HOST/SMTP_FROM отправка отключена, а регистрация с подтверждением почты недоступна.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=12

# Регистрация владельца организации с подтверждением почты
SIGNUP_ENABLED=true
PASSWORD_MIN_LENGTH=12
EMAIL_CODE_TTL_MINUTES=15
EMAIL_CODE_LENGTH=6
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_PER_EMAIL_HOUR=5
EMAIL_CODE_MAX_PER_IP_HOUR=20
CONFIRM_MAX_PER_IP_HOUR=30

# Только для локальной разработки без SMTP: печатать код подтверждения в лог сервера
# вместо отправки письма. В APP_ENV=production включить нельзя.
DEV_LOG_EMAIL_CODES=false
